{
  "name": "pi-actio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi extension: makes a pi coding agent a member of an Actio team (actio tool, /actio Explorer, prompt service)",
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --import tsx --test \"test/*.test.ts\"",
    "smoke": "node --import tsx test/smoke.ts"
  },
  "dependencies": {
    "actio-ts": "file:../actio-ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typebox": "1.3.27",
    "typescript": "^5.7.2"
  }
}
