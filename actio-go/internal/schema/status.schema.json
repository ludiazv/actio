{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "Actio agent status (<agent folder>/status.json)",
  "description": "Written by the agent on every status change and at least every 90 seconds.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/agentId" },
    "status": { "enum": ["inactive", "idle", "busy", "error"] },
    "datetime": { "$ref": "common.schema.json#/$defs/datetime", "description": "Time of the last status update." },
    "msg": { "type": "string", "description": "Last human-readable status message." },
    "load": { "type": "number", "minimum": 0, "maximum": 100, "description": "Estimated load of the agent, in %." },
    "capability_status": {
      "description": "One object per capability with the number of requests running and in queue.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/capabilityName" },
          "running": { "type": "integer", "minimum": 0 },
          "queue": { "type": "integer", "minimum": 0 }
        },
        "required": ["name", "running", "queue"],
        "additionalProperties": false
      }
    },
    "tasks": {
      "description": "Internal tasks of the agent, disclosed at its discretion.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": { "$ref": "common.schema.json#/$defs/capabilityName" },
          "name": { "type": "string", "description": "Agent's internal reference name or ID." },
          "title": { "type": "string", "description": "Short description." },
          "status": { "enum": ["pending", "running", "waiting", "completed", "cancelled"] },
          "progress": { "type": "number", "minimum": 0, "maximum": 100 },
          "eta": { "type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9]$", "description": "Estimated time to completion, hh:mm:ss." }
        },
        "required": ["capability", "status"],
        "additionalProperties": false
      }
    },
    "contention": { "type": "boolean", "description": "Signals consumers to wait before submitting requests." }
  },
  "required": ["id", "status", "datetime", "capability_status"],
  "additionalProperties": false
}
